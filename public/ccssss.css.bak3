  }
}

/* ==============================
   Content Sections Styles
============================== */

.card {
  background-color: var(--card-bg-color);
  border: 1px solid #0000000F;
  padding: var(--padding-medium);
  margin-bottom: var(--padding-medium);
  border-radius: 12px; /* match facelift radius */
  box-shadow: 0 6px 20px #0000001A;
  width: 100%; /* Full width of grid cell */
  max-width: none; /* Remove any width restrictions */
  overflow: hidden; /* make sure child elements respect the radius */
}

/* Wider cards on larger screens */
@media (min-width: 1200px) {
  .grid-container {
    max-width: 1600px; /* Even wider on very large screens */
    padding: var(--padding-large);
  }
  
  .card {
    padding: var(--padding-large);
  }
}

.card h2 {
    font-family: var(--font-hnm11);
    color: var(--text-color);
    margin-top: 0;
    margin-bottom: var(--padding-small);
    font-size: clamp(1.5rem, 3vw, 2.5rem);
}

.post {
    border-bottom: 1px solid #eee;
    padding-bottom: 1rem;
    margin-bottom: 1rem;
}

.post:last-child {
    border-bottom: none;
    margin-bottom: 0;
}

.post h4 {
    font-family: var(--font-hnm11);
    color: var(--text-color);
    margin: 0 0 0.5rem 0;
    font-size: 1.25rem;
}

.post-content {
    font-family: var(--font-main);
    color: var(--text-color);
    line-height: 1.6;
    margin-bottom: 0.5rem;
}

.post-date {
    font-family: var(--font-secondary);
    color: #666666FF;
    font-size: 0.875rem;
}

.featured-item {
    margin: 0 0 1.5rem 0;
}

.featured-item img {
    max-width: 100%;
    height: auto;
  border: 1px solid #DDDDDDFF;
    border-radius: 4px;
}

.featured-item figcaption {
    font-family: var(--font-main);
    color: var(--text-color);
    font-style: italic;
    margin-top: 0.5rem;
    text-align: center;
}

.video-container {
    position: relative;
    padding-bottom: 56.25%; /* 16:9 aspect ratio */
    height: 0;
    overflow: hidden;
    border-radius: 4px;
}

.video-container iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
}

/* Featured HTML Content Styles */
.featured-html {
  background-color: #FFFFFFFF;
  color: #333333FF; /* Dark text color for better contrast */
  padding: 15px;
  border-radius: 8px;
  box-shadow: 0 2px 5px #0000001A;
}

.html-content {
  width: 100%;
  overflow: hidden;
  color: #000000FF; /* Ensure text color is #000000FF */
}

.html-content img {
  max-width: 100%;
  height: auto;
  margin: 0 auto;
  display: block;
}

.social-section {
    text-align: center;
    margin: 2rem 0;
}

.social-section img {
    border-radius: 8px;
    border: 2px solid var(--blew);
    transition: transform 0.3s ease;
}

.social-section img:hover {
    transform: scale(1.05);
}

/* ==============================
   Admin Panel Styles
============================== */

#admin-login-button-container {
    text-align: center;
    margin: var(--padding-medium) 0;
}

.admin-btn {
    background-color: var(--redd);
  color: #FFFFFFFF;
    border: none;
    padding: 10px 20px;
    border-radius: 4px;
    cursor: pointer;
    font-family: var(--font-hnm11);
    font-size: 1rem;
    margin: 10px 5px;
    transition: background-color 0.3s ease;
}

.admin-btn:hover {
    background-color: #d63384;
    transform: translateY(-2px);
}

.admin-panel {
    /* Use the same card styling as content sections */
    background-color: var(--card-bg-color);
    border: 1px solid var(--nav-border-color);
    box-shadow: -17px 20px 0px var(--nav-border-color);
    border-radius: 0; /* Keep card's sharp corners */
    padding: var(--padding-small);
    margin: 2rem auto;
    max-width: 1200px;
    color: #000000FF;
}

.admin-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--nav-border-color);
    padding-bottom: 1rem;
    margin-bottom: 2rem;
}

.admin-header h2 {
    color: var(--redd);
    font-family: 'db', sans-serif; /* Use the same font as card headers */
    font-size: 3rem;
    font-weight: 200;
    letter-spacing: 0.22rem;
    margin: 0;
}

.logout-btn {
    background: var(--button-bg-color);
    color: var(--button-text-color);
    font-family: var(--font-main);
    border: 1px solid var(--nav-border-color);
    padding: 10px 10px;
    letter-spacing: 0.05em;
    line-height: 1.5;
    border-radius: 0px;
    cursor: pointer;
    width: 128px;
    transition: background-color var(--transition-speed) ease 0.4s, color var(--transition-speed) ease 0.4s, transform var(--transition-speed) ease 0.4s;
}

.logout-btn:hover {
    background: #58e880;
    color: #FFFFFFFF;
    transform: scale(1.05);
}

.logout-btn:hover {
    background-color: #888;
}

.admin-section {
    margin-bottom: 3rem;
    padding: 1.5rem;
    background-color: #262626;
    border-radius: 6px;
    border-left: 4px solid var(--blew);
}

.admin-section h3 {
    color: var(--blew);
    font-family: var(--font-hnm11);
    margin-top: 0;
    margin-bottom: 1rem;
}

.admin-section h4 {
  color: #FFFFFFFF;
    font-family: var(--font-hnm11);
    margin-top: 1.5rem;
    margin-bottom: 1rem;
}

.admin-input {
    width: 100%;
    padding: 10px;
    margin: 5px 0 15px 0;
  border: 1px solid #444444FF;
    border-radius: 4px;
  background-color: #333333FF;
  color: #FFFFFFFF;
    font-size: 1rem;
    font-family: var(--font-main);
}

.admin-input:focus {
    outline: none;
    border-color: var(--blew);
    background-color: #404040;
}

.admin-select {
    width: 100%;
    padding: 10px;
    margin: 5px 0 15px 0;
  border: 1px solid #444444FF;
    border-radius: 4px;
  background-color: #333333FF;
  color: #FFFFFFFF;
    font-size: 1rem;
    font-family: var(--font-main);
}

.editor-container {
    margin: 15px 0;
  background-color: #FFFFFFFF;
    border-radius: 4px;
    min-height: 200px;
}

.admin-post-item {
  background-color: #333333FF;
    padding: 15px;
    margin: 10px 0;
    border-radius: 4px;
    border-left: 3px solid var(--redd);
}

.admin-post-item h4 {
    margin: 0 0 10px 0;
  color: #FFFFFFFF;
}

.admin-post-item p {
    margin: 5px 0;
  color: #CCCCCCFF;
    font-size: 0.9rem;
}

.admin-featured-item {
    background-color: #333333FF;
    padding: 15px;
    margin: 10px 0;
    border-radius: 4px;
    border-left: 3px solid var(--blew);
  color: #FFFFFFFF;
}

.edit-post-btn, .delete-post-btn, .delete-featured-btn {
  background-color: #666666FF;
  color: #FFFFFFFF;
    border: none;
    padding: 5px 10px;
    border-radius: 3px;
    cursor: pointer;
    font-size: 0.8rem;
    margin-right: 5px;
}

.delete-post-btn, .delete-featured-btn {
    background-color: #dc3545;
}

.edit-post-btn:hover, .delete-post-btn:hover, .delete-featured-btn:hover {
    opacity: 0.8;
}

#admin-login-button-container {
    text-align: center;
    margin: 2rem 0;
}

/* Modal Styles */
.modal {
    display: none;
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
  background-color: #000000CC;
    align-items: center;
    justify-content: center;
}

.modal-content {
    background-color: #1a1a1a;
    padding: 2rem;
    border-radius: 8px;
    border: 2px solid var(--redd);
    max-width: 400px;
    width: 90%;
    position: relative;
}

.modal-content h2 {
    color: var(--redd);
    font-family: var(--font-hnm11);
    margin-top: 0;
    text-align: center;
}

.close-button {
    position: absolute;
    right: 15px;
    top: 10px;
    font-size: 2rem;
    font-weight: bold;
    color: #f00;
    cursor: pointer;
    transition: color 0.3s ease;
}

.close-button:hover {
    color: #f00;
}

#login-form {
    display: flex;
    flex-direction: column;
}

#login-form input[type="password"] {
  padding: 12px;
  margin: 15px 0;
  border: 1px solid #444444FF;
  border-radius: 4px;
  background-color: #333333FF;
  color: #FFFFFFFF;
  font-size: 1rem;
}

#login-form input[type="password"]:focus {
    outline: none;
    border-color: var(--blew);
    background-color: #404040;
}

#login-form button {
    background-color: var(--redd);
  color: #FFFFFFFF;
    border: none;
    padding: 12px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 1rem;
    font-family: var(--font-hnm11);
}

#login-form button:hover {
    background-color: #d63384;
}

/* Content Section Styles - Maintain Card Styling */
#mission-statement, #posts-section, #featured-content-section, #hours-section {
  margin-bottom: 2rem;
  /* Use card styling tokens; don't force a flat background so per-card gradients can show */
  background-color: transparent;
  border: 1px solid var(--nav-border-color);
  box-shadow: var(--card-shadow);
  padding: var(--padding-small);
  border-radius: var(--card-radius);
}

/* ==============================
   Card Color Variations
============================== */

/* Mission section - Light background like posts was */
#mission-statement.card {
  background-color: transparent !important;
  background-image: var(--sun-grad-1), var(--card-bg-gradient-overlay) !important;
  background-size: cover, cover !important;
  background-repeat: no-repeat !important;
  background-position: center center !important;
  background-blend-mode: multiply, overlay !important;
  color: #111 !important;
}

#mission-statement.card h2 {
  color: var(--text-color);
  font-family: 'kb', sans-serif;
  /* Reduce vertical spacing for a tighter heading */
  margin-top: 0.25rem;
  margin-bottom: 0.5rem;
  line-height: 1.08;
}

/* Reduce the image bottom spacing inside the mission card so the H2 sits closer */
#mission-statement .main-logo {
  margin-bottom: 0.6rem !important;
}

/* Posts section - Blue background that mission had */
#posts-section.card {
  background-color: transparent !important;
  background-image: var(--sun-grad-2), var(--card-bg-gradient-overlay) !important;
  background-size: cover, cover !important;
  background-repeat: no-repeat !important;
  background-position: center center !important;
  background-blend-mode: multiply, overlay !important;
  color: #FFFFFFFF;
  border: 1px solid #0000000F;
}

#posts-section.card h2 {
  color: #FFFFFFFF;
  font-family: 'kb', sans-serif;
  -webkit-text-stroke: 1px #000000FF;
  text-shadow: -1px -1px 0 #000000FF, 1px -1px 0 #000000FF, -1px 1px 0 #000000FF, 1px 1px 0 #000000FF;
}

/* Hours section - Muted teal background */
#hours-section.card {
  background-color: transparent !important;
  background-image: var(--sun-grad-5), var(--card-bg-gradient-overlay) !important;
  background-size: cover, cover !important;
  background-repeat: no-repeat !important;
  background-position: center center !important;
  background-blend-mode: multiply, overlay !important;
  color: #081717;
  border: 1px solid #0000000F;
}

#hours-section.card h2 {
  color: #000000FF;
  font-family: 'kb', sans-serif;
  -webkit-text-stroke: 1px #FFFFFFFF;
  text-shadow: -1px -1px 0 #FFFFFFFF, 1px -1px 0 #FFFFFFFF, -1px 1px 0 #FFFFFFFF, 1px 1px 0 #FFFFFFFF;
}

/* Social media section - Purple background using existing var */
/* Social section: match the global card facelift and ensure images/QR inherit radius */
#social-section.card {
  background-color: transparent !important;
  background-image: var(--sun-grad-6), var(--card-bg-gradient-overlay) !important;
  background-size: cover, cover !important;
  background-repeat: no-repeat !important;
  background-position: center center !important;
  background-blend-mode: multiply, overlay !important;
  color: #111 !important;
  border: 1px solid #0000000F;
  box-shadow: 0 6px 20px #0000001A;
  border-radius: var(--card-radius);
  overflow: hidden;
}

#social-section.card h2 {
  color: #000000FF;
  font-family: 'kb', sans-serif;
  -webkit-text-stroke: 1px #FFFFFFFF;
  text-shadow: -1px -1px 0 #FFFFFFFF, 1px -1px 0 #FFFFFFFF, -1px 1px 0 #FFFFFFFF, 1px 1px 0 #FFFFFFFF;
}

#social-section.card a {
  color: #000000FF;
  text-decoration: underline;
  font-weight: bold;
}

/* Make social links inside the Follow Us card match the Insta card styling */
#social-section.card .social-links, #social-section.card .social-content {
  text-align: center;
  display: block;
  gap: 8px;
}

#social-section.card .social-links a, #social-section.card .social-content a {
  display: inline-block;
  padding: 8px 12px;
  margin: 6px 4px;
  background: #FFFFFF0F;
  border: 1px solid #0000000F;
  border-radius: 8px;
  color: var(--marigold);
  text-decoration: none;
  font-weight: 800;
}

/* High-contrast stroked links utility. Use for bright/yellow links to improve legibility */
.stroked-link {
  -webkit-text-stroke: 1px #000000BF; /* primary outline for WebKit */
  text-stroke: 1px #000000BF; /* non-standard but safe to include */
  text-shadow: 0 0 0 #00000000, /* keep existing layout */
               -1px -1px 0 #000000BF,
               1px -1px 0 #000000BF,
               -1px 1px 0 #000000BF,
               1px 1px 0 #000000BF;
}

#social-section.card .social-links a:hover, #social-section.card .social-content a:hover {
  background: #FFFFFF1F;
  transform: translateY(-2px);
}

/* Apply stroked-link to social marigold links for better contrast */
#social-section.card .social-links a, #social-section.card .social-content a {
  -webkit-text-stroke: 1px #00000099;
  text-stroke: 1px #00000099;
  text-shadow: -1px -1px 0 #00000099, 1px -1px 0 #00000099, -1px 1px 0 #00000099, 1px 1px 0 #00000099;
}

/* Make any inline buttons/links in social feel like buttons */
#social-section.card a.btn-like, #social-section.card .btn-like {
  display: inline-block;
  padding: 8px 14px;
  border-radius: 10px;
  background: #FFFFFF0F;
  border: 1px solid #0000000F;
  transition: background-color 0.2s ease, transform 0.15s ease;
}
#social-section.card a.btn-like:hover, #social-section.card .btn-like:hover {
  transform: translateY(-3px);
  background: #FFFFFF1F;
}

/* Ensure QR/image inside social uses same rounding */
#social-section.card img,
#social-section.card picture,
#social-section.card svg {
  border-radius: 10px; /* slightly inset from container radius */
  border: 1px solid #FFFFFF1F;
  box-shadow: 0 4px 12px #00000014;
  display: inline-block;
}

/* Full-bleed image container: stretches edge-to-edge but keeps the card’s outer radius */
.card-bleed {
  width: 100%;
  display: block;
  overflow: hidden; /* ensures bleed content respects outer radius */
  border-top-left-radius: 0; /* child image will sit flush */
  border-top-right-radius: 0;
  margin-top: 0; /* flush to card edge */
  padding-top: 0; /* override any card padding so the image sits edge-to-edge */
}

.card-bleed .social-qr {
  width: 100%;
  height: auto;
  display: block;
  margin: 0;
  box-shadow: none; /* full-bleed looks cleaner without inner shadow */
  border: none; /* remove inner border so it touches the edges */
  object-fit: cover; /* ensure it fills the width nicely */
}

/* Posts section keeps default card styling */

/* ==============================
   Mobile Header Layout Fix
============================== */
@media (max-width: 1000px) {
  .diy-thrift-wrapper {
    flex-direction: column !important;
    flex-wrap: nowrap !important;
    align-items: center !important;
    gap: 0.2rem !important;
  }
  .diy-thrift-wrapper h2 {
    font-size: clamp(2rem, 3.5vw, 4rem) !important;
    scale: 0.6 !important;
  }
  .diy-thrift-wrapper h1 .span2 {
    font-size: clamp(4.5rem, 10vw, 12rem) !important;
  }
}

/* Featured section - Red background */
#featured-content-section.card {
  /* Feature gets a strong sunset gradient (pink -> coral) */
  background: linear-gradient(180deg, var(--pupil), var(--coral-orange));
  color: #FFFFFFFF;
  border: 1px solid #0000000F;
}

#featured-content-section.card h2 {
  color: #FFFFFFFF;
  font-family: 'kb', sans-serif;
  -webkit-text-stroke: 1px #000000FF;
  text-shadow: -1px -1px 0 #000000FF, 1px -1px 0 #000000FF, -1px 1px 0 #000000FF, 1px 1px 0 #000000FF;
}

/* ==============================
   Desktop Layout Improvements
============================== */
@media (min-width: 1024px) {
  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* Constrain header/footer inner content to match the grid container and keep header background full-bleed */

  /* Restore full-bleed header background and keep inner content constrained to the grid width */
  header.feader {
    background: var(--header-bg);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .header-container,
  footer > div {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    box-sizing: border-box;
    width: 100%;
    background: transparent;
    border-radius: 0;
  }
  
  .card {
    max-width: none; /* Remove any width restrictions on desktop */
    width: 100%;
  }
  
  /* Primary two-column layout: main content + sidebar */
  #content-container {
    display: grid;
    grid-template-columns: 1fr 340px; /* main column + sidebar */
    grid-template-rows: auto auto auto auto;
    grid-template-areas:
      "mission mission"
      "posts featured"
      "insta social"
      "hours hours";
    gap: 2.5rem; /* increased gap so cards don't touch */
    align-items: start;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    justify-items: stretch;
  }

  /* Map sections to semantic grid areas for predictable layout */
  #mission-statement { grid-area: mission; }
  #posts-section { grid-area: posts; }
  #featured-content-section { grid-area: featured; }
  #insta-section { grid-area: insta; }
  #hours-section { grid-area: hours; }
  #social-section { grid-area: social; }

  /* Ensure these flow correctly if content is narrower */
  #posts-section, #featured-content-section, #hours-section, #mission-statement {
    width: 100%;
    max-width: none;
    margin: 0;
  }
}

/* ==============================
   Responsive Enhancements (Mobile-First Tweaks)
   Breakpoints: 1200, 1000, 768, 480
   These rules aim to ensure header/HOWDY, cards, images and footer scale and stack nicely.
   ============================== */

/* Large desktop: keep current layout, but ensure moderate spacing */
@media (min-width: 1200px) {
  body { padding: 40px; }
  .header-container { max-width: 1400px; margin: 0 auto; }
}

/* Tablet / small desktop */
@media (max-width: 1000px) {
  body { padding: 28px; }
  .grid-container, .griddy { gap: 20px; padding: 20px; }

  /* Reduce HOWDY scale slightly to preserve vertical space */
  .header-title .span2 { font-size: clamp(4.0rem, 11vw, 14rem); }
  .diy-thrift-wrapper { gap: 0.4rem; }
  .card { padding: 20px; }
}

/* Single-column layout for medium and small screens - stack grid areas */
@media (max-width: 1000px) {
  #content-container {
    display: block;
    width: 100%;
    margin: 0 auto;
  }

  #content-container > section {
    width: 100%;
    margin-bottom: 1.25rem;
  }
}

/* Clamp card headings for consistent responsive scale */
.card h2 {
  font-size: clamp(1.6rem, 2.8vw, 2.6rem);
  line-height: 1.05;
  margin-bottom: 0.8rem;
}

/* Small tablet / large phone */
@media (max-width: 768px) {
  body { padding: 18px; gap: 18px; }
  header.feader { padding-top: 8px; padding-bottom: 8px; background-attachment: scroll; }

  /* Stack header elements vertically and center */
  .diy-thrift-wrapper { flex-direction: column; align-items: center; gap: 6px; }
  .header-container { justify-content: center; }

  /* Clamp HOWDY to a smaller max to avoid overflow */
  .header-title .span2 { font-size: clamp(3.8rem, 14vw, 11rem); line-height: 0.92; margin-left: 0; }
  .header-title { padding-top: 12px; }

  /* Card sizing */
  .card { padding: 18px; box-shadow: 0 2px 6px #00000014; }

  /* Make footer and logos scale down */
  .main-logo { height: 96px !important; }
  .footer-logo img { height: 88px !important; }

  /* Reduce mission image size */
  #mission-statement .main-logo { height: 120px !important; }
}

/* Phones */
@media (max-width: 480px) {
  body { padding: 12px; gap: 12px; }

  /* HOWDY: ensure it never consumes too much vertical space */
  .header-title .span2 { font-size: clamp(3rem, 18vw, 7.5rem); line-height: 0.9; }

  /* Keep header compact */
  header.feader { min-height: 88px; background-attachment: scroll; }
  .diy-thrift-wrapper { gap: 4px; }

  /* Cards: tighter, single-column flow */
  .grid-container, .griddy { grid-template-columns: 1fr; padding: 10px; gap: 12px; }
  .card { padding: 12px; margin-bottom: 12px; }

  /* Make images responsive and not too tall */
  .card img, .featured-item img, .social-section img { max-height: 220px; width: auto; }

  /* Buttons bigger touch targets */
  button, .admin-btn, .popup-ticket-link { padding: 12px 16px; font-size: 1rem; }

  /* Reduce howdy letter animation travel to avoid clipping on tiny screens */
  .howdy-letter { will-change: transform, opacity; }
}

/* Small fix: if viewport height is small, clamp HOWDY vertical starting offset via body data attribute (JS-friendly) */
@media (max-height: 600px) {
  .header-title .span2 { font-size: clamp(2.6rem, 16vw, 6.8rem); }
}

/* ======================================================
   Theme normalization / authoritative overrides
   Ensures the modernized card style wins over earlier conflicting rules
   ====================================================== */

/* Page background: slightly warm off-#FFFFFFFF for contrast */
body {
  background-color: var(--page-bg-contrast);
}

/* Ensure all .card variants share the same visual tokens */
.card {
  background-color: var(--card-bg-color);
  /* allow per-card background-image (sun-grad) to show through with a subtle overlay */
  background-image: var(--card-bg-gradient-overlay);
  background-blend-mode: multiply, overlay;
  border-radius: var(--card-radius);
  border: var(--card-border);
  box-shadow: var(--card-shadow);
  padding: 18px;
}

/* Per-card sunrise gradients (use !important to override the generic card bg)
   These add variety while keeping the unified tokens for radius and shadow. */
#mission-statement.card {
  background-color: transparent !important;
  background-image: var(--sun-grad-1), var(--card-bg-gradient-overlay) !important;
  background-size: cover, cover !important;
  background-repeat: no-repeat !important;
  background-position: center center !important;
  background-blend-mode: multiply, overlay !important;
  color: #111 !important;
}

#posts-section.card {
  background-color: transparent !important;
  background-image: var(--sun-grad-2), var(--card-bg-gradient-overlay) !important;
  background-size: cover, cover !important;
  background-repeat: no-repeat !important;
  background-position: center center !important;
  background-blend-mode: multiply, overlay !important;
  color: #111 !important;
}

#insta-section.card {
  background-color: transparent !important;
  background-image: var(--sun-grad-3), var(--card-bg-gradient-overlay) !important;
  background-size: cover, cover !important;
  background-repeat: no-repeat !important;
  background-position: center center !important;
  background-blend-mode: multiply, overlay !important;
  color: #111 !important;
}

#featured-content-section.card {
  background-color: transparent !important;
  background-image: var(--sun-grad-4), var(--card-bg-gradient-overlay) !important;
  background-size: cover, cover !important;
  background-repeat: no-repeat !important;
  background-position: center center !important;
  background-blend-mode: multiply, overlay !important;
  color: #111 !important;
}

#hours-section.card {
  background-color: transparent !important;
  background-image: var(--sun-grad-5), var(--card-bg-gradient-overlay) !important;
  background-size: cover, cover !important;
  background-repeat: no-repeat !important;
  background-position: center center !important;
  background-blend-mode: multiply, overlay !important;
  color: #111 !important;
}

#social-section.card {
  background-color: transparent !important;
  background-image: var(--sun-grad-6), var(--card-bg-gradient-overlay) !important;
  background-size: cover, cover !important;
  background-repeat: no-repeat !important;
  background-position: center center !important;
  background-blend-mode: multiply, overlay !important;
  color: #111 !important;
}

.admin-panel,
.modal-content {
  border-radius: var(--card-radius) !important;
  border: var(--card-border) !important;
  box-shadow: var(--card-shadow) !important;
  overflow: hidden !important;
  /* Slight translucency so the paper grain shows through */
  background-color: #FFFFFFDD !important;
  background-blend-mode: overlay !important;
}

/* Ensure social-section uses the same shadow/border (authoritative) */
#social-section.card {
  border: var(--card-border) !important;
  box-shadow: var(--card-shadow) !important;
  /* Preserve per-card sunrise gradient instead of forcing #FFFFFFFF */
  background-image: var(--sun-grad-6), var(--card-bg-gradient-overlay) !important;
  background-blend-mode: multiply, overlay !important;
}

/* Neutralize older heavy offset shadows used in a few selectors */
#mission-statement, #posts-section, #featured-content-section, #hours-section, .admin-panel, .modal-content {
  box-shadow: var(--card-shadow) !important;
  border: var(--card-border) !important;
}

/* Tighter hover tokens */
.card:hover {
  transform: translateY(-6px) !important;
  box-shadow: var(--card-hover-shadow) !important;
}

/* Increase the grain opacity to make it more visible but still subtle */
body::before {
  opacity: var(--paper-grain-opacity) !important;
}

/* Make sure the full-bleed image does not accidentally add its own border/shadow */
.card-bleed .social-qr {
  box-shadow: none !important;
  border: none !important;
}

/* Small responsive tweak: reduce radius on tiny screens so content breathes */
@media (max-width: 480px) {
  :root { --card-radius: 8px; }
}

/* =======================================================
   Authoritative Card Normalization (highest priority)
   Ensures all cards share the same radius, border and shadow
   and neutralizes orphaned legacy rules that made them inconsistent
   ======================================================= */

/* Apply the master tokens to the most common card selectors */
.card, section.card, div.card, .card[class] {
  border-radius: var(--card-radius) !important;
  border: var(--card-border) !important;
  box-shadow: var(--card-shadow) !important;
  background-color: var(--card-bg-color) !important;
  background-image: var(--card-bg-gradient-overlay) !important;
  background-blend-mode: overlay !important;
  overflow: hidden; /* clip children to the rounded container */
}

/* Global spacing: ensure cards and sections have consistent vertical rhythm */
main > section, #content-container > section, .card {
  margin-bottom: 1.5rem; /* consistent vertical spacing between cards */
}

/* Make sure images, pictures, svg and videos inside cards visually match the container
   but avoid forcing shadows on inline media; images should sit flush inside the card */
.card img, .card picture, .card svg, .card video, .card iframe {
  border-radius: max(2px, calc(var(--card-radius) - 4px)) !important;
  box-shadow: none !important;
  display: block;
  max-width: 100%;
  height: auto;
}

/* Elements that intentionally use full-bleed behavior keep their exception rules */
.card-bleed, .card-bleed * { border-radius: 0 !important; box-shadow: none !important; }

/* Clear out intermittent legacy offset shadows applied to header/main/footer so they don't
   conflict with the card tokens (these selectors were used in older styles) */
header, main, footer, .admin-panel, .modal, .popup-overlay {
  box-shadow: var(--card-shadow) !important;
  border-radius: var(--card-radius) !important;
}

/* Keep hover token consistent and authoritative */
.card:hover {
  transform: translateY(-6px) !important;
  box-shadow: var(--card-hover-shadow) !important;
  border-color: #0000001F !important;
}

/* Ensure embedded third-party widgets conform where possible (instagram blockquote)
   but preserve their internal layout — this reduces the jarring mix of radii */
blockquote.instagram-media { border-radius: calc(var(--card-radius) - 4px) !important; box-shadow: var(--card-shadow) !important; }

/* Fallback safety: enforce box-sizing within cards */
.card, .card * { box-sizing: border-box; }

