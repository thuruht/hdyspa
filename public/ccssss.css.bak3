/* Sorting Controls Styles */
.sorting-controls {
    margin-top: 10px;
    display: flex;
    gap: 0.5rem; 
    padding: 2px 4px;
   

}



.drop-crawl {
  opacity: 0;
  position: relative; 
  cursor: crosshair; 
  }

.drop-wiggle {
  opacity: 1; /* Changed from 0 to make header visible */
  position: relative; 
  cursor: crosshair;
  overflow: visible;
  text-shadow: 0px 2px 5px #00000033;
  transform-style: preserve-3d;
  perspective: 1000px;
  }

.insect {

 object-fit: cover; opacity : 0.69;
  
}
.cocoon {
  background-color: #E9D38222; 
  text-shadow: 1px 1px 3px #A0522D44; 
}

.sopc { background-color: #00000004;  border: 1px dotted #fc00ff33; }
.social-icons, .sopc { font-family:'hnbi4'; font-weight: 200; list-style: none; align-items: center; text-align: center; color: #3f3f3f; text-transform: lowercase; font-size:1rem; padding: 0;
  margin: 0;
  gap: 10px;  border-radius: 100%; -webkit-text-stroke: 1px #FFFFFFFF; /* White outline */
     text-shadow: -1px -1px 0 #FFFFFFFF, 1px -1px 0 #FFFFFFFF, -1px 1px 0 #FFFFFFFF, 1px 1px 0 #FFFFFFFF;}

.pp  {color: #454545; font-family: 'kb'; font-weight: 100; font-size: 1.87rem; margin-bottom:var(--padding-large); -webkit-text-stroke: 1px #000000FF; /* White outline */ letter-spacing: 0.11rem; text-align: left; width: 100%;
     text-shadow: -1px -1px 0 #a0e600, 1px -1px 0 #FFFFFFFF, -1px 1px 0 #FFFFFFFF, 1px 1px 0 #e60000; /*White text shadow*/}
      
