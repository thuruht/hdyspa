/* farewellcafe.com/css/ccssss.css */

:root {
    /* Colors */
  --pupil: #D990FFFF;
  --redd: #FF2B13FF;
  --lima: #B0EE00FF;
  --blew: #00E2FFFF;
  --primary-bg-color: #B0EE00FF;
  --secondary-bg-color: #D090FFFF;
  --accent-color: #FF2B13FF;
  --text-color: #204C4CFF;
  --header-text-shadow: #00000080;
    --nav-bg-color: #FFFFFFFF;
    --nav-border-color: #000000FF;
  --card-bg-color: #999DF9FF; /* near-#FFFFFFFF with subtle warmth (less beige) */
  /* much lighter overlay so the underlying gradient shows vibrant colors */
  /* Per-card overlay alpha (default subtle). JS can randomize --card-overlay-alpha per-card */
  --card-overlay-alpha: 0.06; /* slightly stronger to keep texture while letting gradients read */
  /* make gradient overlays a bit more visible so the vivid palette reads stronger */
  --card-overlay-alpha-visible: 0.12;
  --card-bg-gradient-overlay: linear-gradient(180deg, rgba(255,255,255,var(--card-overlay-alpha)), #00000000);
  --button-bg-color: #B0EE00FF;
  --button-text-color: #000000FF;
    --header-bg: var(--primary-bg-color) url('./bg4.png') center/cover no-repeat; /* Combined background */
  --howder-bg: var(--secondary-bg-color) url('./bg7.png') center/cover no-repeat;
    /* Fonts */
    --font-howder: 'ds', sans-serif;
    --font-main: 'hnb2', sans-serif;
    --font-secondary: 'kb', sans-serif;
    --font-db: 'db', sans-serif;
    --font-mt: 'mt', sans-serif;
    --font-hnm11: 'hnm11', sans-serif;
    --font-hnmi12: 'hnmi12', sans-serif;
    --font-hnbi4: 'hnbi4', sans-serif;

    /* Spacing */
    --padding-small: 24px;
    --padding-medium: 32px;
    --padding-large: 36px;

    /* Other */
    --transition-speed: 0.3s;
  /* New theme tokens for card/layout modernization */
  --card-radius: 12px;
  --card-border: 1px solid #0000000F;
  --card-shadow: 0 8px 28px #0000001E;
  --card-hover-shadow: 0 18px 40px #00000023;
  --page-bg-contrast: #FFF8F308; /* subtle, very light wash so bg image shows through */
  --paper-grain-opacity: 0.18; /* controls paper grain visibility */
  /* Site width token: used to align header/footer inner content and grid container */
  --site-max-width: 1360px;
  /* Sunrise gradient tokens using team palette variables (fallbacks provided) */
  /* More vivid sunrise ramps using team colors (pink/orange/purple emphasis) */
  --sun-grad-1: linear-gradient(140deg, var(--team-pink-2, #ED207BFF) 0%, var(--team-magenta-2, #FD2979FF) 28%, var(--team-pink-1, #FB5C98FF) 56%, var(--team-marigold-2, #F5C44BFF) 100%);
  --sun-grad-2: linear-gradient(120deg, var(--team-orange-2, #FE7D39FF) 0%, var(--team-gold-2, #F4C543FF) 30%, var(--team-pink-1, #FB5C98FF) 65%, #00000005 100%);
  --sun-grad-3: linear-gradient(160deg, var(--team-magenta-2, #FD2979FF) 0%, var(--team-pink-2, #ED207BFF) 32%, var(--team-orange-2, #FE7D39FF) 68%, var(--team-marigold-2, #F5C44BFF) 100%);
  --sun-grad-4: linear-gradient(110deg, var(--team-lavender, #DFBAE3FF) 0%, var(--team-pink-1, #FB5C98FF) 35%, var(--team-magenta-1, #BB67AAFF) 65%, #FFFFFF05 100%);
  --sun-grad-5: linear-gradient(150deg, var(--team-pink-1, #FB5C98FF) 0%, var(--team-orange-1, #F25A2BFF) 45%, var(--team-magenta-2, #FD2979FF) 78%, var(--team-gold-1, #E4BA65FF) 100%);
  --sun-grad-6: linear-gradient(130deg, var(--team-orange-1, #F25A2BFF) 0%, var(--team-pink-2, #ED207BFF) 30%, var(--team-gold-2, #F4C543FF) 65%, var(--team-lavender, #DFBAE3FF) 100%);
}
/* ==============================
   2. Font Faces
============================== */

@font-face {
    font-family: 'ds';
    src: url('./ds.woff2') format('woff2');
      font-weight: normal;
  font-style: normal;
    font-display: swap;
  }

@font-face {
  font-family: 'db';
  src: url('./db.woff2') format('woff2');
  font-weight: normal;
  font-style: normal;
     font-display: swap;
}

@font-face {
  font-family: 'kb';
  src: url('./kb.woff2') format('woff2');
        font-weight: normal;
  font-style: normal;
     font-display: swap;
}

@font-face {
  font-family: 'mt';
  src: url('./mrt.woff2') format('woff2');
  font-weight: normal;
  font-style: normal;
     font-display: swap;
}

@font-face {
  font-family: 'hnm11';
  src: url('./hnm11.woff2') format('woff2');
  font-weight: normal;
  font-style: normal;
     font-display: swap;
}

@font-face {
  font-family: 'hnmi12';
  src: url('./hnmi12.woff2') format('woff2');
    font-weight: normal;
  font-style: normal;
     font-display: swap;
}

@font-face {
  font-family: 'hnb2';
  src: url('./hnb2.woff2') format('woff2');
    font-weight: normal;
  font-style: normal;
     font-display: swap;
}

@font-face {
  font-family: 'hnbi4';
  src: url('./hnbi4.woff2') format('woff2');
    font-weight: normal;
  font-style: normal;
     font-display: swap;
}
/* ==============================
   3. Global Styles
============================== */
*, *::before, *::after {
  box-sizing: border-box; /* Ensures consistent sizing across elements */
}

/* ==============================
   99. Inline-style consolidation
   (Moved from <style> blocks in index.html)
   Utility classes and popup/modal styles
============================== */

/* Popup / modal (moved from index.html) */
.popup-overlay {
    background-color: #00000000;
    background-image: var(--card-bg-gradient-overlay);
    background-blend-mode: overlay;
  border: 1px solid #0000000F;
    padding: var(--padding-medium);
    margin-bottom: var(--padding-medium);
    border-radius: var(--card-radius); /* match facelift radius */
    box-shadow: var(--card-shadow);
    width: 100%; /* Full width of grid cell */
    max-width: none; /* Remove any width restrictions */
    overflow: hidden; /* make sure child elements respect the radius */

.event-popup {
    /* Use card styling for consistency */
    background-color: #00000000;
    color: #000000FF;
    border: 1px solid var(--nav-border-color);
    box-shadow: var(--card-shadow);
    padding: var(--padding-medium);
    position: relative;
    max-width: 500px;
    width: 90%;
    max-height: 80vh;
    overflow-y: auto;
  }
  .modal.show .modal-content {
    transform: scale(1);
  }
  padding: 20px;
    /* Use the same card styling as content sections */
    background-color: transparent;
    background-image: var(--card-bg-gradient-overlay);
    background-blend-mode: overlay;
    border: 1px solid var(--nav-border-color);
    box-shadow: var(--card-shadow);
    border-radius: var(--card-radius);
    padding: var(--padding-small);
    margin: 2rem auto;
  color: var(--text-color);
  border-bottom: 2px solid var(--nav-border-color);
  padding-bottom: 10px;
}
.event-card {
  border: 1px solid var(--nav-border-color);
  margin: 15px 0;
  padding: 20px;
  background: linear-gradient(180deg, #FFFFFFFF 0%, #FFFFFFDD 100%);
  border-radius: 8px;
  box-shadow: 0 2px 8px #0000001A;
  transition: all 0.18s ease;
}
.event-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 6px 18px #0000001E;
}
.event-card-row {
  display: flex;
  gap: 20px;
  align-items: flex-start;
}
.event-thumb {
  width: 100px;
  height: 100px;
  object-fit: cover;
  border-radius: 6px;
  flex-shrink: 0;
  border: 2px solid var(--nav-border-color);
}
.event-noimage {
  width: 100px;
  height: 100px;
  background: var(--nav-border-color);
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFFFF;
  font-size: 12px;
  text-align: center;
  flex-shrink: 0;
}
.event-card-body {
  flex: 1;
}
.event-title {
  margin: 0 0 12px 0;
  color: var(--text-color);
  font-size: 1.2em;
  line-height: 1.3;
  font-weight: 700;
}
.event-meta-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 8px;
  margin-bottom: 12px;
}
.event-meta {
  margin: 0;
  color: var(--text-color);
  display: flex;
  align-items: center;
  gap: 8px;
}
.meta-emoji { font-size: 1.1em; }
.event-desc {
  margin: 12px 0;
  color: var(--text-color);
  font-size: 0.95em;
  line-height: 1.5;
  padding: 10px;
  background: #0000000D;
  border-radius: 4px;
  border-left: 3px solid var(--nav-border-color);
}
.ticket-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-top: 12px;
  padding: 10px 16px;
  background: var(--button-bg-color);
  color: var(--button-text-color);
  text-decoration: none;
  border-radius: 6px;
  font-size: 0.95em;
  font-weight: 700;
  transition: all 0.15s ease;
  border: 2px solid transparent;
}
.ticket-link:hover { transform: translateY(-2px); }
.popup-footer { text-align: center; margin-top: 20px; }
.popup-footer-note { color: var(--text-color); opacity: 0.8; }

.popup-close {
  position: absolute;
  top: 10px;
  right: 20px;
  color: #FFFFFFFF;
  font-size: 2.5rem;
  font-weight: bold;
  cursor: pointer;
  transition: color 0.3s ease;
}
.popup-close:hover { color: #FF4500FF; }

.popup-content { display:flex; gap:2rem; }
.popup-thumbnail { width:200px; height:auto; object-fit:cover; border:1px solid #222; }
.popup-details { flex:1; }
.popup-details h2 { font-family: var(--font-hnm11); font-size:2rem; margin-top:0; color:#FFFFFFFF; line-height:1.2; }
.popup-details p { font-family: var(--font-main); font-size:1rem; color:#CCCCCCFF; margin:0.5rem 0; }
.popup-description { margin-top:1rem; font-style:italic; #FFFFFFFF-space:pre-wrap; }
.popup-price { font-weight:bold; font-size:1.1rem; color:#FF4500FF; }
.popup-ticket-link { display:inline-block; margin-top:1.5rem; padding:10px 20px; background-color:#FF4500FF; color:#FFFFFFFF; text-decoration:none; font-family:var(--font-hnm11); text-transform:uppercase; border:none; border-radius:2px; transition:background-color 0.3s ease; }
.popup-ticket-link:hover { background-color:#E03E00FF; }

@media (max-width:768px) {
  .event-popup { padding:1.5rem; }
  .popup-content { flex-direction:column; gap:1.5rem; }
  .popup-thumbnail { width:100%; max-width:300px; margin:0 auto; }
  .popup-details h2 { font-size:1.5rem; }
}

/* Header / brand helper classes (replacing inline styles in index.html) */
.header-scaled { transform: scale(.87); min-height:128px; max-height:224px; }
.header-container { display:flex; align-items:center; justify-content:center; flex-wrap:wrap; gap:.5rem; }
.diy-thrift-wrapper { display:flex; gap:.5rem; align-items:center; order:1; }
.brand-subtext { color:var(--redd); font-size:clamp(2.5rem, 3.9vw, 6.5rem); transform:scale(.69); display:inline-block; }
.header-title.drop-wiggle { transform:scale(.87); display:inline-block; font-family:'mt'; #FFFFFFFF-space:nowrap; }
.howdy-letter { display:inline-block; }

/* Constrain header/footer inner content to the site width without forcing min-widths
   (we want the header content to align with the cards container but not stretch images) */
.header-container, footer > div {
  max-width: var(--site-max-width);
  margin: 0 auto;
  padding: 0 2rem;
  box-sizing: border-box;
  width: 100%;
}

/* Let header children size naturally inside the constrained container */
.header-container .main-logo,
.header-container .brand-subtext,
.header-container .header-title,
.header-container .diy-thrift-wrapper {
  max-width: 100%;
  width: auto;
}

/* Utilities */
.hidden { display:none !important; }
.text-center { text-align:center; }
.mb-1-5rem { margin-bottom:1.5rem; }
.main-logo { height:128px; width:auto; opacity:0.95; }
.main-logo.large { height:156px; }
.mascot { width:212px; }
.insta-embed { background:#FFFFFFFF; border:0; border-radius:3px; box-shadow:0 0 1px 0 #00000080,0 1px 10px 0 #00000026; margin:1px; max-width:540px; min-width:326px; padding:0; width:calc(100% - 2px); }
.insta-padding { padding:16px; }
.insta-grid .social-links { text-align:center; margin-top:.6rem; }

/* Small utilities used by admin templates */
.mt-1 { margin-top: 1rem; }
.mt-0-5 { margin-top: 0.5rem; }
.mb-10 { margin-bottom: 10px; }
.border-top-subtle { border-top: 1px solid #333333FF; padding-top: 15px; }
.hours-image-section { display:block; }
.current-hours-image img, .current-hours-image { margin-bottom: 10px; }
.hours-image-upload { margin-top: 10px; }
.button-group { display:flex; gap:10px; margin-top:10px; align-items:center; }
.button-group .admin-btn { margin: 0; }
.admin-image { max-width: 100%; max-height: 200px; border: 1px solid #444444FF; display: block; }
.howdy-debug {
  pointer-events: auto !important;
  z-index: 100005 !important;
  transition: transform 120ms ease !important;
}

/* HOWDY hover/interactive classes to avoid inline styles */
.howdy-hovered {
  transform: scale(1.18) !important;
  transition: transform 120ms ease !important;
}
.howdy-interactive {
  pointer-events: auto !important;
  z-index: 3000 !important;
}

/* fallback image sizing utility */
.image-fallback { display:block; max-width:180px; margin:20px auto; }

/* gentle HOWDY hover class for non-GSAP fallback */
.howdy-hovered-fallback { transform: scale(1.12); transition: transform 180ms ease; }

/* Ensure HOWDY letters inherit a theme color via CSS variable so JS doesn't set color inline */
.howdy-letter { color: var(--pupil); -webkit-text-fill-color: currentColor; }
.insta-view { color: #3897f0; font-family: Arial, sans-serif; font-size: 14px; font-weight: 550; line-height: 18px; }

/* Instagram placeholder utilities */
.insta-placeholder-col { display:flex; flex-direction:column; flex-grow:1; justify-content:center; }
.w-100 { width:100px; margin-bottom:6px; height:14px; }
.w-60 { width:60px; height:14px; }
.insta-aspect { padding-top: 19%; }
.insta-aspect-small { padding-top: 12.5%; }
.insta-row { display:flex; flex-direction:row; margin-bottom:14px; align-items:center; }
.placeholder-circle.small-12 { height:12.5px; width:12.5px; border-radius:50%; background:#F4F4F4FF; transform:translateX(0) translateY(7px); display:inline-block; }
.placeholder-rect.tiny-12 { width:12.5px; height:12.5px; background:#F4F4F4FF; display:inline-block; transform:rotate(-45deg) translateX(3px) translateY(1px); margin-right:14px; margin-left:2px; }
.placeholder-circle.shifted { height:12.5px; width:12.5px; border-radius:50%; background:#F4F4F4FF; transform:translateX(9px) translateY(-18px); display:inline-block; }
.insta-row-mid { margin-left:8px; }
.placeholder-circle.mid-20 { height:20px; width:20px; border-radius:50%; background:#F4F4F4FF; }
.triangle-mark { width:0; height:0; border-top:2px solid #00000000; border-left:6px solid #F4F4F4FF; border-bottom:2px solid #00000000; transform:translateX(16px) translateY(-4px) rotate(30deg); }
.insta-row-right { margin-left:auto; display:flex; gap:8px; align-items:center; }
.pointer-mark { width:0; border-top:8px solid #F4F4F4FF; border-right:8px solid #00000000; transform: translateY(16px); }
.placeholder-rect.small-16 { height:12px; width:16px; transform:translateY(-4px); background:#F4F4F4FF; }
.pointer-mark-2 { width:0; height:0; border-top:8px solid #F4F4F4FF; border-left:8px solid #00000000; transform: translateY(-4px) translateX(8px); }

/* Admin/login defaults */
#admin-panel, #login-modal { display:none; }
/* Visibility helper used by JS to show/hide panels without inline styles */
.is-visible { display: block !important; }

/* Social content helper */
.social-content { text-align:center; }

/* Reusable UI helpers used to replace inline styles in HTML/JS templates */
.mission-lead {
  font-weight: bold;
  font-size: 1.2rem;
  text-align: center;
  margin-bottom: 1rem;
  font-family: var(--font-main);
}

.admin-login-button-container { margin-top: 1rem; }

.footer-logo { text-align: center; margin-bottom: 1.5rem; }
.footer-logo img { height: 128px; width: auto; opacity: 0.9; }

.insta-caption { color:#c9c8cd; font-family:Arial,sans-serif; font-size:14px; line-height:17px; margin-bottom:0; margin-top:8px; overflow:hidden; padding:8px 0 7px; text-align:center; text-overflow:ellipsis; #FFFFFFFF-space:nowrap; }
.insta-caption a { color: #c9c8cd; font-family:Arial,sans-serif; font-size:14px; font-style:normal; font-weight:normal; line-height:17px; }

.insta-link { background:#FFFFFFFF; line-height:0; padding:0; text-align:center; text-decoration:none; width:100%; display:block; }
.insta-embed { background:#FFFFFFFF; border:0; border-radius:3px; box-shadow:0 0 1px 0 #0000007F,0 1px 10px 0 #00000026; margin:1px; max-width:540px; min-width:326px; padding:0; width:calc(100% - 2px); }
.insta-padding { padding:16px; }

.placeholder-row { display:flex; flex-direction:row; align-items:center; }
.placeholder-circle { background-color:#F4F4F4FF; border-radius:50%; flex-shrink:0; height:40px; margin-right:14px; width:40px; }
.placeholder-rect { background-color:#F4F4F4FF; border-radius:4px; height:14px; }
.spinner-box { display:block; height:50px; margin:0 auto 12px; width:50px; }

.html-content { color: #333333FF; background-color: transparent; padding: 15px; border-radius: 8px; box-shadow: 0 2px 5px #00000033; text-shadow:1px 1px 2px #FFFFFFFF; }
.figcaption { color: #c9c9c9; }

/* Consolidated :root overrides and UI mappings (moved from index.html) */
/* NOTE: These intentionally follow the primary :root block and will override where necessary */
:root {
  --sunset-pink:   #E23A6BFF;
  --coral-orange:  #FF6A3CFF;
  --marigold:      #FFB84DFF;
  --lavender:      #D8B4F8FF;
  --teal-accent:   #46BFB6FF;
  --sienna:        #7F4428FF;

  --team-orange-1: #F25A2BFF;
  --team-magenta-1: #BB67AAFF;
  --team-peach: #FD9D69FF;
  --team-lavender: #DFBAE3FF;
  --team-pink-1: #FB5C98FF;
  --team-orange-2: #FE7D39FF;
  --team-magenta-2: #FD2979FF;
  --team-pink-2: #ED207BFF;
  --team-gold-1: #E4BA65FF;
  --team-marigold-2: #F5C44BFF;
  --team-lime-pale: #F5FE91FF;
  --team-gold-2: #F4C543FF;
  --team-neon-y: #EFFE66FF;

  --pupil: var(--team-magenta-2);
  --coral-orange: var(--team-orange-2);
  --marigold: var(--team-marigold-2);
  --lavender: var(--team-lavender);

  --pupil:         var(--sunset-pink);
  --redd:          var(--coral-orange);

  --primary-bg-color:  #FFF6F4FF;
  --secondary-bg-color:#FFEFE8FF;
  --accent-color:      var(--marigold);
  --text-color:        #261717FF;

  --nav-bg-color:   #FFFFFFFF;
  --nav-border-color: var(--sienna);
  --card-bg-color:  transparent; /* prefer per-card gradients from authoritative overrides */
  --button-bg-color: var(--redd);
  --button-text-color: #FFFFFFFF;

  --header-bg: linear-gradient(140deg, #f1679acc 0%, #fa56d6aa 50%, rgb(248, 183, 129) 100%), url('./bg4.png') center/cover no-repeat;
  --howder-bg: linear-gradient(140deg, #cb80fdcc 0%, #fd9f77aa 100%), url('./bg7.png') center/cover no-repeat;

  --page-bg-start: var(--page-bg-contrast);
  --page-bg-end: #00FFCCFF;
  --scroll-start-percent: 0.10;
  --scroll-end-padding: 400px;
}

body.howdy-active {
  --pupil: var(--sunset-pink);
  --redd:  var(--coral-orange);
  --primary-bg-color: #FFF6F4FF;
  --secondary-bg-color: #FFEFE8FF;
  --text-color: #221212FF;
  --header-bg: linear-gradient(40deg, #f75b91FF 10%, #fde34da4 45%, #FF9A6AFF 99%), url('./bg3.png') center/cover no-repeat;
}

/* small UI mappings previously inlined */
.nav ul li:hover { background-color: #FF586E14; }
a:hover { color: var(--lavender); }
.popup-ticket-link, .popup-price, .admin-btn { background-color: var(--button-bg-color); color: var(--button-text-color); border-color: var(--sienna); }
.card { box-shadow: 0 10px 0px #7F442817; border: 1px solid var(--nav-border-color); background-color: transparent; background-image: var(--card-bg-gradient-overlay); background-blend-mode: overlay; }
  .header-title .span2 { color: var(--pupil); text-shadow: 0 3px 0 #00000014; }

body {
  display: flex; /* Enables Flexbox for body */
  flex-direction: column; /* Stacks child elements vertically */
  align-items: center; /* Centers child elements horizontally */
  justify-content: flex-start; /* Aligns child elements to the top */
  margin: 0 auto;
  margin-bottom:24px;
  font-family: var(--font-main); /* hnb2 for main content */
  /* Layer a CSS-variable-driven gradient OVER the bg image so we can animate color
     without replacing or removing the background image. The JS tween will update
     --page-bg-start / --page-bg-end to animate the wash while the image stays fixed. */
  background-image: linear-gradient(180deg, var(--page-bg-start, #FFF8F300), var(--page-bg-end, #00FFCC1E)), url('./bgbg.png');
  background-size: contain; /* changed to allow background-image/gradient to show */
  background-position: center;
  background-repeat: no-repeat;
  background-attachment: fixed;
  background-blend-mode: overlay;
  color: var(--text-color);
  padding: var(--padding-medium);
  text-align: center;
  gap:var(--padding-medium);
  font-family: 'kb';
}

/* ==============================
   4. Header Styles
============================== */
.feader {
  display: flex;
  align-items: center;
  justify-content: flex-start; /* Aligns the contain div to the start (left) */
  width: 100%; 
  /* Use the theme-driven header background at all sizes so it doesn't disappear when
     crossing responsive breakpoints. Mobile browsers often ignore background-attachment:fixed,
     so we keep the image but allow JS/CSS to override attachment per-breakpoint below. */
  background: var(--header-bg);
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  color: var(--text-color);
  padding: 0;
  border: none;
 
}
.howder {
  background: var(--header-bg);
  border: 1px solid var(--nav-border-color);
  align-items: center;
  justify-content: center;
}
.contain {
  display: flex;
  width: 100%;
  min-height:286px;
  margin: 0; /* Removes centering to align left */
  gap: 32px;
  align-items: center; /* Vertically centers left and right */ 
}

.left {
  width: 128px; /* Adjusted for better navigation width */
  flex-shrink: 0; /* Prevents shrinking on smaller screens */
}

.right {
  flex-grow: 1;
  display: flex;
  justify-content: center; /* Centers content horizontally */
  align-items: center;     /* Centers content vertically */
}

.feader h1 {
  margin: 0;
  color: var(--text-color);
  display: flex;
  align-items: center; /* Vertically centers spans within h1 */
  text-align: center;
}

/* ==============================
   19. Responsive <h1> Styles with clamp()
============================== */
.header-title {
  position: relative; /* Establishes a positioning context for absolutely positioned children */
  font-family: 'mt';
  font-size: clamp(1.8rem, 8vw, 6rem); /* Responsive font size */
  z-index:1;
  margin: 0;
  color: var(--text-color);
  transition: font-size 0.3s ease; /* Smooth transition for resizing */
}

.header-title .sulk {
  position: absolute; /* Positions "HOWDY" relative to .header-title */
  bottom: -14px;       /* Adjusts vertical placement */
  right: -2px;       /* Adjusts horizontal placement */
  transform: rotate(-15deg); /* Angles the "HOWDY" text */
  font-family: 'kb';
  color: #FFFFFFFF;
  font-size: clamp(1.2rem, 4vw, 3.0rem); /* Responsive font size relative to .header-title */
  letter-spacing: 0.1em; cursor: crosshair;
  
  /* 1px #000000FF Outline for 'kb' Font */
  -webkit-text-stroke: 1px #000000FF; /* For WebKit browsers */
  text-shadow:
    -1px -1px 0 #000000FF,
     1px -1px 0 #000000FF,
    -1px  1px 0 #000000FF,
     1px  1px 0 #000000FF; /* Fallback for other browsers */
}

.sulk:hover {
  transform: scale(1.4) rotate(12deg);
  color: #FF2B13FF;
  z-index:3;
}


.header-title .span2 {
  /* Use the muted primary pupil color and soften outline to avoid bubblegum tone */
  color: var(--pupil);
  font-family: 'mt';
  font-size: clamp(5.9rem, 11.6vw, 17rem); /* Responsive font size relative to .header-title */
  letter-spacing: 0.002em;
  font-weight: 300;
  margin-left: 12px; /* Spacing between text and span2 */
  margin-top:0; margin-bottom:0;
  /* Slightly softer outline/shadow */
  -webkit-text-stroke: 0.8px #000000E6;
  text-shadow:
  -0.6px -0.6px 0 #000000D9,
   0.6px -0.6px 0 #000000D9,
  -0.6px  0.6px 0 #000000D9,
   0.6px  0.6px 0 #000000D9,
  -10px 10px 0px #7F44280D;
}

/* HOWDY gradient style (purple -> pupil pink -> orange) */
.howdy-gradient {
  /* richer multi-stop gradient for HOWDY text */
  background-image: linear-gradient(90deg,
    #7B46FFFF 0%,      /* deep purple */
    #9E6BFFFF 18%,     /* softer purple */
    #D090FFFF 34%,     /* lavender */
    var(--pupil) 50%, /* team pink */
    #FF7A2DFF 72%,     /* vivid orange */
    #FFB347FF 92%      /* warm gold */
  );
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent; /* show gradient through text */
  -webkit-text-stroke: 0.5px #000000D9;
  text-shadow: none;
}

/* ==============================
   5. Navigation Styles
============================== */
nav ul {
  display: flex; /* Enables Flexbox for nav items */
  flex-direction: column; /* Stacks nav items vertically */
  align-items: flex-start; /* Aligns items to the start (left) */
  list-style: none;
  padding: 0;
  margin: 0; margin-top:12px;
  gap: 0px; /* Space between nav items */
  background-color: var(--nav-bg-color);
  border: 1px solid var(--nav-border-color);
  border-left: 0px;
  box-shadow: 0px 18px 0px #000000FF;
}

nav ul li {
  width: 100%; /* Makes each nav item take full width of nav */
  padding: 10px 15px; /* Enhanced padding for better click area */
  margin: 0;
  border: 1px solid var(--nav-border-color);
  background: var(--nav-bg-color);
  font-family: var(--font-hnbi4);
  font-size: 1rem;
  text-align: left; /* Align text to the left */
  letter-spacing: 0.05em;
  line-height: 1.5;
  font-weight: normal;
  border-radius: 0px; /* Rounded corners */
  transition: background-color var(--transition-speed) ease, color var(--transition-speed) ease;
}

nav ul li:hover {
  background-color: var(--nav-border-color);
  color: #FFFFFFFF; border: 1px solid #FC00FFFF;
}

nav ul li a {
  text-decoration: none;
  color: inherit; /* Inherits color from parent for hover effect */
  font-family: var(--font-main);
  text-align: left;
  display: block; /* Ensures the entire area is clickable */
}

/* ==============================
   6. Calendar Styles
============================== */
#calendar {
  background: #FFFFFFFF;
  color: var(--text-color);
  padding: 0;  width: 96%;
  margin: 0 auto;
  /*margin-bottom:12px;*/
  border: 1px solid var(--nav-border-color);
  border-radius: 0px; /* Optional: Rounded corners */
    grid-column: 1;      /* left column */
  grid-row: 1 / 3;     /* spans row 1 and row 2 */

}

.cally { max-width: 100%; height: auto; vertical-align: middle;}




/* ==============================
   7. Newsletter Styles
============================== */
#newsletter {
  /* Removed - newsletter section deprecated */
  display: none;
}

#newsletter h2 { color: #FFFFFFFF;
  -webkit-text-stroke: 1px #000000FF; /* #000000FF outline */
   text-shadow: -1px -1px 0 #000000FF, 1px -1px 0 #000000FF, -1px 1px 0 #000000FF, 1px 1px 0 #000000FF; /*#000000FF text shadow*/

  font-family: var(--font-secondary);
  margin-bottom: var(--padding-small);

}
#newsletter p {
  margin-bottom: var(--padding-medium);
}

#newsletter form {
  display: flex;
  flex-direction: column; /* Stack elements vertically */
  gap: 0.5rem; /* Reduced spacing between input and button */
  align-items: stretch; /* Ensures children take full width */
  width: 93%; /* Ensure form takes full width of the container */
  max-width: 100%; /* Use full width of parent card */
  margin: 0 auto; /* Center the form within its container */
  text-align: center;
  justify-content: center;
  align-items: center;
}

#newsletter input#newsletter-email {
  padding: 10px 10px; /* Reduced padding for a slimmer appearance */
  border: 1px solid var(--nav-border-color);
  border-radius: 0px;
  font-size: 1rem;
  width: 93%; /* Ensures input takes full width of the form */
  height: 35px; /* Set a fixed height */
  box-sizing: border-box; /* Ensures padding is included in the height */
}

#newsletter button {
  background: var(--button-bg-color);
  color: var(--button-text-color);
  font-family: var(--font-main);
  border: 1px solid var(--nav-border-color);
  padding: 10px 10px; /* Adjusted padding to match input height */
  letter-spacing: 0.05em;
  line-height: 1.5;
  border-radius: 0px;
  cursor: pointer;
  width: 128px;
  transition: background-color var(--transition-speed) ease, color var(--transition-speed) ease, transform var(--transition-speed) ease;
  height: 35px; /* Matches the input's height */
  box-sizing: border-box; /* Ensures padding is included in the height */
}

#newsletter button:hover {
  background: #A0E600FF;
  color: #FFFFFFFF;
  transform: scale(1.05);
}

#newsletter button:active {
  transform: scale(0.98);
}

/* ==============================
   8. Contact Styles
============================== */
#contact {
  background: #B0EE00FF;
  text-align: center;
  padding: var(--padding-medium);
width: 96%;
  margin: 0 auto;
  /*margin-bottom:12px;*/
  border: 1px solid var(--nav-border-color);
  border-radius: 0px; /* Optional: Rounded corners */
  grid-column: 1;      
  grid-row: 3;     
  font-family: 'hnm11';
  font-weight:900;
}

#contact h2 {
  font-family: var(--font-secondary);
  margin-bottom: var(--padding-small);
  color:#FFFFFFFF;
 color: #000000FF;
    -webkit-text-stroke: 1px #FFFFFFFF; /* White outline */
     text-shadow: -1px -1px 0 #FFFFFFFF, 1px -1px 0 #FFFFFFFF, -1px 1px 0 #FFFFFFFF, 1px 1px 0 #FFFFFFFF; /*White text shadow*/
     }

#contact p {
  margin-bottom: var(--padding-medium);
}

#contact .social-icons {
  margin-bottom: var(--padding-medium);
}

#contact .social-icons a {
  margin: 0 10px;
  color: var(--text-color);
  text-decoration: none;
  font-weight: bold;
  transition: color var(--transition-speed) ease;
}

#contact .social-icons a:hover {
  color: var(--accent-color);
}

#contact img {
  width: 200px;
  height: auto;
  margin: 0 auto;
  display: block;
  border: 0px solid transparent; /* Moved from inline to CSS */
  border-radius: 0px; /* Optional: Rounded corners */
  opacity:0.8;
}

#newsletter img {
  width: 200px;
  height: auto;
  margin: 0 auto;
  display: block;
  border: 0px solid transparent; /* Moved from inline to CSS */
  border-radius: 0px; /* Optional: Rounded corners */
  opacity:0.8;
}


/* ==============================
   9. Event Styles
============================== */
#event {
  background: #00E2FFFF;
  text-align: center;
  padding: var(--padding-medium);
 width: 96%;
  margin: 0 auto;
  /*margin-bottom:12px;*/
  border: 1px solid var(--nav-border-color);
  border-radius: 0px; /* Optional: Rounded corners */
 grid-column: 2;      
  grid-row: 2 / 4;     /* spans row 2 and row 3 */
}



/* ==============================
   10. Footer Styles
============================== */
footer div {
  /* Style footer inner container like other cards (no full-width beige band) */
  background: transparent; /* remove full-width color */
  color: var(--text-color);
  border: var(--card-border); /* 1px solid subtle */
  box-shadow: var(--card-shadow);
  padding: var(--padding-small);
  width: 100%;
  margin: 20px 0;
  text-align: center;
  border-radius: var(--card-radius);
  letter-spacing: 0.12rem; /* reduced spacing to match cards */
  line-height: 1.3rem;
  font-size: 1rem;
}

/* Remove card styling from specific footer elements that should "hang out" */
footer .footer-logo,
footer #admin-login-button-container {
  background: none !important;
  border: none !important;
  box-shadow: none !important;
  padding: 0 !important;
  margin: 1rem 0 !important;
}

footer .admin-btn {
  /* Let the admin button hang out naturally */
  margin: 0 !important;
}

footer {
  width: 100%;
}

/* ==============================
   11. Typography
============================== */
h1, h2, h3, h4, h5, h6 {
  margin: 0;
  padding: 0.2rem 0;
}

h2 {
  font-family: var(--font-secondary);
  font-size: 3.8rem;
  margin-bottom: var(--padding-small);
  
  /* 1px #000000FF Outline for 'kb' Font */
  -webkit-text-stroke: 1px #000000FF; /* For WebKit browsers */
  text-shadow:
    -1px -1px 0 #000000FF,
     1px -1px 0 #000000FF,
    -1px  1px 0 #000000FF,
     1px  1px 0 #000000FF; /* Fallback for other browsers */
}

p {
  margin-left: 0.5em;
}

.grid-container {
  display: grid;
  grid-template-columns: 1fr 1fr;   /* 2 columns */
  grid-template-rows: auto auto auto;  /* 3 rows */
  grid-gap: 32px;
  gap: 32px;
  padding: var(--padding-medium);
  width: 100%;
  max-width: 1400px; /* Wider content area for desktop */
  margin: 0 auto;
  text-align: center;
  justify-content: center; /* Centers the grid items */
  align-items: center; /* Centers the grid items */
  align-items: center;
  justify-items: center; /* Centers the grid items */
}

/* Media query: single column below 640px (or whatever size you want) */
@media (max-width: 1001px) {
  .grid-container {
    /* Only 1 column, as many auto-rows as needed */
    grid-template-columns: 1fr;
    grid-template-rows: repeat(4, auto);
    grid-gap: 32px; /* You can adjust the gap for smaller screens */
  }
  
  /* Force each section to occupy full width in a new row */
  #calendar {
    grid-column: 1;
    grid-row: auto; /* Each item in its own row in 1-column layout */
  }
  #newsletter {
    grid-column: 1;
    grid-row: auto;
  }
  #event {
    grid-column: 1;
    grid-row: auto;
  }
  #contact {
    grid-column: 1;
    grid-row: auto;
  }


}
@media (max-width: 640px) {
