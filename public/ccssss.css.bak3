} */
.contain {display:block;}
nav ul {display:flex; flex-direction:row;}
.left {width:100%; display:block;}
.right {width:100%; display: block;}
nav ul li { font-size:0.8rem;}

.header-title .span2 {text-align:center; align-content:center; align-items:center;}

.header-title {text-align:center; align-content:center; align-items:center; padding:20px; padding-top:40px;}

header {text-align:center; align-content:center; align-items:center; margin-bottom:36px;}
}

/* ==============================
   13. Grid Items Styling
============================== */
.card {
  /* Facelift: rounded, softer shadow, consistent border */
  background-color: transparent;
  background-image: var(--card-bg-gradient-overlay);
  background-blend-mode: overlay;
  padding: var(--padding-small);
  border: 1px solid #0000000F; /* softer border for modern look */
  border-radius: 12px; /* consistent rounded corners for all cards */
  box-shadow: 0 6px 20px #0000001A; /* gentle elevated shadow */
  margin: 0 auto;
  transition: transform var(--transition-speed) ease, box-shadow var(--transition-speed) ease, border-color var(--transition-speed) ease;
  display: block;
  color: #000000FF;
  overflow: hidden; /* ensures gradients and media are clipped to the rounded corners */
}

/* Instagram feed grid */
.insta-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
  gap: 8px;
  align-items: start;
  justify-items: center;
}
.insta-grid img {
  width: 100%;
  height: 120px;
  object-fit: cover;
  border-radius: 8px;
  border: 1px solid #0000000F;
}
.insta-grid .insta-item {
  width: 100%;
}

/* Tactile hover lift for cards */
.card:hover {
  transform: translateY(-6px);
  box-shadow: 0 18px 30px #0000001E;
  border-color: #0000001E;
}


.card img {
  max-width: 100%;
  height: auto;
 vertical-align:middle;
  margin: 0 auto;
  gap:0;
}



/* ==============================
   17. Button Styles
============================== */
button {
  background: var(--button-bg-color);
  color: var(--button-text-color);
  font-family: var(--font-main);
  border: 1px solid var(--nav-border-color);
  padding: 10px 10px;
  letter-spacing: 0.05em;
  line-height: 1.5;
  border-radius: 0px;
  cursor: pointer;
  width: 128px;
  transition: background-color var(--transition-speed) ease  0.4s, color var(--transition-speed) ease  0.4s, transform var(--transition-speed) ease 0.4s; 
}

button:hover {
  background: #58e880;
  color: #FFFFFFFF;
  transform: scale(1.05);
}

button:active {
  transform: scale(0.98);
}

